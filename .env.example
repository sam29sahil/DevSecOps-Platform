# ============================================================
# FRONTEND
# ============================================================

VITE_API_BASE_URL=http://127.0.0.1:5000/api

# ============================================================
# AWS ECR
# ============================================================

AWS_REGION=ap-south-1
AWS_ECR_REPOSITORY=devsecops-platform

CONTAINER_REGISTRY=288418346751.dkr.ecr.ap-south-1.amazonaws.com
CONTAINER_REGISTRY_REPOSITORY=devsecops-platform

# ============================================================
# RENDER API DEPLOYMENT
# Keep these values in the Render BACKEND environment only.
# Create an API key in Render Account Settings.
# Find the workspace ID in Render workspace settings (starts with "tea-").
# The backend refreshes the AWS ECR pull token before each deployment.
# ============================================================

RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_REGION=singapore
RENDER_PLAN=free

# ============================================================
# PIPELINE EXECUTION MODE
#
# local  = Docker/Trivy/ECR run on the local machine
# hosted = Docker/Trivy/ECR run through GitHub Actions
# ============================================================

PIPELINE_EXECUTION_MODE=local

# ============================================================
# GITHUB ACTIONS INTEGRATION
# Required when PIPELINE_EXECUTION_MODE=hosted
# ============================================================

GITHUB_TOKEN=
GITHUB_REPOSITORY=sam29sahil/DevSecOps-Platform
GITHUB_CALLBACK_URL=https://devsecops-platform.onrender.com
GITHUB_CALLBACK_SECRET=