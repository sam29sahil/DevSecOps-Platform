# ============================================================
# FRONTEND
# ============================================================

VITE_API_BASE_URL=http://127.0.0.1:5000/api

# ============================================================
# AWS ECR
# ============================================================

AWS_REGION=ap-south-1
AWS_ECR_REPOSITORY=devsecops-platform

CONTAINER_REGISTRY=288418346751.dkr.ecr.ap-south-1.amazonaws.com
CONTAINER_REGISTRY_REPOSITORY=devsecops-platform

# ============================================================
# PIPELINE EXECUTION MODE
#
# hosted = Remote execution on GitHub Actions runners (Recommended).
#          Executes Docker build, Trivy scan, AWS ECR push, and AWS ECS Fargate deploy.
#          The Flask backend polls GitHub Actions directly using GITHUB_TOKEN.
# local  = Local execution (requires local Docker Desktop daemon running).
# ============================================================

PIPELINE_EXECUTION_MODE=hosted

# ============================================================
# GITHUB ACTIONS INTEGRATION
#
# Create a GitHub Fine-Grained Personal Access Token (PAT) with:
# - Target Repository: sam29sahil/DevSecOps-Platform
# - Permissions:
#     * Actions:  Read and write  (to trigger workflow_dispatch & query runs)
#     * Contents: Read            (to read workflow file and repository)
# Never commit this token to git. .env is ignored in .gitignore.
# ============================================================

GITHUB_TOKEN=
GITHUB_REPOSITORY=sam29sahil/DevSecOps-Platform

# ============================================================
# AWS DEPLOYMENT TARGET (Read-only platform references)
# AWS authentication uses GitHub Actions OIDC (No secret keys needed in .env)
# ============================================================

AWS_REGION=ap-south-1
AWS_ECR_REPOSITORY=devsecops-platform
AWS_ECS_CLUSTER=devsecops-cluster

CONTAINER_REGISTRY=288418346751.dkr.ecr.ap-south-1.amazonaws.com
CONTAINER_REGISTRY_REPOSITORY=devsecops-platform

# ============================================================
# OPTIONAL EXTERNAL WEBHOOK CALLBACKS
# Only needed when exposing the local server to internet via tunnel (e.g. ngrok).
# When running locally, the backend polls GitHub Actions directly using GITHUB_TOKEN.
# ============================================================

GITHUB_CALLBACK_URL=
GITHUB_CALLBACK_SECRET=