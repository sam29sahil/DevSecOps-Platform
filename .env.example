# ============================================================
# FRONTEND
# ============================================================

VITE_API_BASE_URL=http://127.0.0.1:5000/api

# ============================================================
# AWS ECR
#
# Registry the pipeline pushes built images to, and the
# repository name used inside that registry.
# ============================================================

AWS_REGION=ap-south-1
AWS_ECR_REPOSITORY=devsecops-platform
CONTAINER_REGISTRY=288418346751.dkr.ecr.ap-south-1.amazonaws.com
CONTAINER_REGISTRY_REPOSITORY=devsecops-platform

# ============================================================
# AWS credentials are intentionally omitted. boto3 uses the standard
# credential provider chain locally, and GitHub Actions uses OIDC.
# ============================================================
