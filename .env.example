# ============================================================
# FRONTEND
# ============================================================

VITE_API_BASE_URL=http://127.0.0.1:5000/api

# ============================================================
# CONTAINER REGISTRY
#
# Registry the pipeline pushes built images to, and the
# repository name used inside that registry.
# ============================================================

CONTAINER_REGISTRY=
CONTAINER_REGISTRY_REPOSITORY=

# ============================================================
# AZURE SERVICE PRINCIPAL
#
# Credentials for the pipeline's dedicated service principal.
# Used for both the container registry push and the Container
# App deployment.  A CLI user profile cannot be used: it is an
# interactive credential and cannot be refreshed
# non-interactively under Entra security defaults.
#
# Fill these in a local .env file, which is git-ignored.
# NEVER commit real values.
# ============================================================

AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ============================================================
# AZURE DEPLOYMENT TARGET
#
# The dedicated Container App the pipeline deploys to.  This
# must not be the Container App that hosts this platform.
# ============================================================

AZURE_RESOURCE_GROUP=
AZURE_CONTAINER_APP_NAME=
