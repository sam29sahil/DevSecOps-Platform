# ============================================================
# FRONTEND
# ============================================================

VITE_API_BASE_URL=http://127.0.0.1:5000/api

# ============================================================
# AWS ECR
# ============================================================

AWS_REGION=ap-south-1
AWS_ECR_REPOSITORY=devsecops-platform

CONTAINER_REGISTRY=288418346751.dkr.ecr.ap-south-1.amazonaws.com
CONTAINER_REGISTRY_REPOSITORY=devsecops-platform

# ============================================================
# PIPELINE EXECUTION MODE
#
# hosted = Docker build, Trivy scan, AWS ECR push, and ECS Fargate
#          deploy run remotely in GitHub Actions runners. The Flask backend
#          polls GitHub Actions directly for real-time status and logs.
#          (Recommended for Windows laptop development & demonstrations)
# local  = Docker/Trivy/ECR run locally (requires local Docker Desktop)
# ============================================================

PIPELINE_EXECUTION_MODE=hosted

# ============================================================
# GITHUB ACTIONS INTEGRATION
# ============================================================

GITHUB_TOKEN=
GITHUB_REPOSITORY=sam29sahil/DevSecOps-Platform

# Optional: GITHUB_CALLBACK_URL is only needed if using an external webhook tunnel (e.g. ngrok).
# When running locally, the platform polls GitHub Actions API directly using GITHUB_TOKEN.
GITHUB_CALLBACK_URL=
GITHUB_CALLBACK_SECRET=